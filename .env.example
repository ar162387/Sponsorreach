# Use a dedicated database; the importer never changes the original scraper DB.
DATABASE_URL=postgresql://localhost:55432/sponsormatch
SPONSORMATCH_ENV=development
SPONSORMATCH_API_URL=http://127.0.0.1:8001
SPONSORMATCH_API_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
OPENAI_API_KEY=
# Local MiniLM runs on this machine without any embedding API key.
EMBEDDING_PROVIDER=local
REQUIRE_VERIFIED_EMAIL=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_CONNECTION_STRING=
SUPABASE_DATABASE_PASSWORD=
RESEND_API_KEY=
# AgentaOS preparation only: deliberately inactive placeholders.
# Server-only checkout settings. See docs/PAYMENT_SETUP_STEPS.md.
# AGENTAOS_API_KEY=
# AGENTAOS_SHORTLIST_LINK_ID=
# AGENTAOS_WEBHOOK_SECRET=
# AGENTAOS_RETURN_ORIGIN=https://sponsorreach.uk
# Current monthly offer: EUR 24.99 for 100 credits.
SPONSORMATCH_CONTROLLER_NAME=
SPONSORMATCH_PRIVACY_EMAIL=

# Per-process limit: API + worker default to at most eight DB connections total.
SPONSORMATCH_DB_POOL_SIZE=4
MATCH_WORKER_CONCURRENCY=2

# Monthly billing remains disabled until full provider/entitlement integration is verified.
BILLING_MODE=off
# Server-only application credentials (CLI/OAuth sessions are not application keys).
# AGENTAOS_TEST_PRODUCT_ID=<EUR monthly payment link ID>
# AGENTAOS_API_KEY=
# AGENTAOS_WEBHOOK_SECRET=
# AGENTAOS_BUSINESS_ID=b460db5b-7fdb-49ff-a81c-cc15f343e90c

# Admin access uses verified Supabase Auth user UUIDs, not email or editable metadata.
# SPONSORREACH_ADMIN_USER_IDS=
# SPONSORMATCH_SUPPORT_EMAIL=
# SPONSORMATCH_OPERATOR_ADDRESS=
# SPONSORMATCH_OPERATOR_JURISDICTION=
# SPONSORMATCH_OPERATOR_REGISTRATION=

# Single administrator, selected by the owner. Password is managed in Supabase Auth.
SPONSORREACH_ADMIN_EMAIL=accessgpt69@gmail.com

# Explicit opt-in to let signed-in reviewers use hosted test-card checkout.
# This flag has no effect on live-payment approval.
BILLING_TEST_CHECKOUT_PUBLIC=false

# Member social sign-in and deletion. Store live credentials in the private runtime.
SOCIAL_GOOGLE_ENABLED=false
SOCIAL_FACEBOOK_ENABLED=false
GOOGLE_WEB_CLIENT_ID=
META_APP_ID=
META_APP_SECRET=
SUPABASE_SECRET_KEY=
SPONSORREACH_DELETION_FROM=
SPONSORREACH_CLOSURE_JOB_SECRET=
